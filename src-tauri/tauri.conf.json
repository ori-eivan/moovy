{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moovy",
  "version": "0.1.3",
  "identifier": "com.orieivan.moovy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "card",
        "title": "Moovy",
        "url": "index.html",
        "width": 380,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "acceptFirstMouse": true
      },
      {
        "label": "settings",
        "title": "Moovy",
        "url": "index.html",
        "width": 380,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ori Eivan",
    "copyright": "Copyright (c) 2026 Ori Eivan",
    "shortDescription": "A friendly companion that reminds you to drink water and move.",
    "homepage": "https://github.com/ori-eivan/moovy",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
