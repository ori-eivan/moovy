# Clash Display and Chillax (ITF Free Font License) may be used in the app but not
# redistributed through a repository. Keep the files local only; the UI falls back when
# they are missing.
public/fonts/clash-display/
public/fonts/chillax/

# Character art. Everything here stays local by default: pilot art may be third-party fan
# art and must never be committed. Original packs that ship are allowed in one by one, below,
# under ASSETS_LICENSE (CC BY-NC 4.0).
public/characters/*
!public/characters/thomas/
!public/characters/corni/

